# Use a unique password of at least 16 characters. Never reuse the old playground passcode.
ADMIN_PASSWORD=
# At least 32 random characters. Changing this signs out existing sessions.
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token: Contents read/write for this repository only.
GITHUB_CONTENT_TOKEN=
# Vercel API token with access to this project's Web Analytics.
VERCEL_ANALYTICS_TOKEN=
